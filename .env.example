# База данных PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ptracker
DB_SSLMODE=disable

# Порт веб-приложения
PORT=1111

# Секретный ключ для подписи сессионных cookie
SESSION_SECRET=ptracker-production-cookie-secret-key-32b

# Мониторинг сети (пингер)
PINGER_ENABLED=false
