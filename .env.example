# База данных PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tracker
DB_SSLMODE=disable

# Порт веб-приложения
PORT=1111

# Секретный ключ для подписи сессионных cookie
SESSION_SECRET=tracker-production-cookie-secret-key-32b

# Мониторинг сети (пингер)
PINGER_ENABLED=false

# Fake Name Generator API (генерация случайных профилей сотрудников при сидировании)
FNG_API_KEY=""
